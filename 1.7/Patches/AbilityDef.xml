<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="Anneli_Infest"]/iconPath</xpath>
    <value>
      <iconPath>Anneli_Retheme_DarkSouls/Anneli_UI/Anneli_Infect</iconPath>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="Anneli_Infest"]/label</xpath>
    <value>
      <label>share the darksign</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="Anneli_Infest"]/description</xpath>
    <value>
      <description>Imprint the Darksign on another humanoid. The curse will take root within them, and in time their flesh will leave behind accursed Ashes.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/AbilityDef[defName="Anneli_Infest"]/comps</xpath>
    <value>
      <li Class="Annelitrice.Retheme.DarkSouls.CompProperties_DarksignTransfer" />
    </value>
  </Operation>
</Patch>
