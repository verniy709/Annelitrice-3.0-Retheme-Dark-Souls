  <!-- MeatAmount controls the ordinary meat yield; useMeatFrom alone does not produce meat. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Annelitrice"]/statBases/MeatAmount</xpath>
    <value>
      <MeatAmount>0</MeatAmount>
    </value>
  </Operation>

  <!-- Adult Annelitrice: add nutrient solution to the butcher products. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Annelitrice"]</xpath>
    <value>
      <butcherProducts>
        <Anneli_NutrientSolution>30</Anneli_NutrientSolution>
      </butcherProducts>
    </value>
  </Operation>
</Patch>
