    <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Annelitrice"]/label</xpath>
    <value>
      <label>[TODO] Annelitrice race name</label>
    </value>
  </Operation>

  <!-- TODO: AlienRace.ThingDef_AlienRace Annelitrice / description -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Annelitrice"]/description</xpath>
    <value>
      <description>[TODO] Annelitrice race lore and gameplay description.</description>
    </value>
