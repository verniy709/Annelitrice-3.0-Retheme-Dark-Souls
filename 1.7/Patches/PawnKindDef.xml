    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/alternateGraphics/li[texPath="Anneli_Larva/Larva3"]/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_DarkSouls/Anneli_Larva/Larva3</texPath>
