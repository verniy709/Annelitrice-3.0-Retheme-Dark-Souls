    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/alternateGraphics/li[texPath="Anneli_Larva/Larva5"]/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_DarkSouls/Anneli_Larva/Larva5</texPath>
