<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- TODO: PawnKindDef Anneli_Larva / label -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/label</xpath>
    <value>
      <label>[TODO] Larva pawn kind</label>
    </value>
  </Operation>

  <!-- Enlarge the rethemed larva body graphic. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/lifeStages/li/bodyGraphicData/drawSize</xpath>
    <value>
      <drawSize>1.25</drawSize>
    </value>
  </Operation>

