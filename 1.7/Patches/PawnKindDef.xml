    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/alternateGraphics/li[texPath="Anneli_Larva/Larva8"]</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/lifeStages/li/bodyGraphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_DarkSouls/Anneli_Larva/Larva</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="Anneli_Larva"]/lifeStages/li/dessicatedBodyGraphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_DarkSouls/Anneli_Larva/Dessicated_Larva</texPath>
