<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="Cure_Anneli_Infection"]/label</xpath>
    <value>
      <label>remove the annelitrice darksign</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="Cure_Anneli_Infection"]/description</xpath>
    <value>
      <description>This medical operation removes the Annelitrice Darksign.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="Cure_Anneli_Infection"]/jobString</xpath>
    <value>
      <jobString>Removing the Annelitrice Darksign.</jobString>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="Cure_Anneli_Infection"]/successfullyRemovedHediffMessage</xpath>
    <value>
      <successfullyRemovedHediffMessage>{0} has removed {1}'s Annelitrice Darksign.</successfullyRemovedHediffMessage>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="HatchAnneliEggs"]/label</xpath>
    <value>
      <label>awaken annelitrice humanity</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="HatchAnneliEggs"]/description</xpath>
    <value>
      <description>Awaken Annelitrice Humanity from Ashes.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="ButcherAnneliEggs"]/label</xpath>
    <value>
      <label>grind annelitrice ashes</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CremateAnneliEggs"]/label</xpath>
    <value>
      <label>cremate annelitrice ashes</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="Anneli_AnthelminticAnneliEggs"]/label</xpath>
    <value>
      <label>annelitrice blooming moss production</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="Anneli_AnthelminticAnneliEggs"]/description</xpath>
    <value>
      <description>Annelitrice blooming moss production.</description>
    </value>
  </Operation>

  <!-- Butchery yields Anneli_NutrientSolution -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="ButcherAnneliEggs"]/products</xpath>
    <value>
      <products>
        <Anneli_NutrientSolution>5</Anneli_NutrientSolution>
      </products>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="ResurrectAnneliCorpse"]/label</xpath>
    <value>
      <label>revive an annelitrice undead</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="ResurrectAnneliCorpse"]/description</xpath>
    <value>
      <description>Use an Annelitrice Soul to revive a fallen Annelitrice Undead.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="ResurrectAnneliCorpse"]/jobString</xpath>
    <value>
      <jobString>Reviving an Annelitrice Undead.</jobString>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="HatchAnneliEggs"]/jobString</xpath>
    <value>
      <jobString>Awakening Annelitrice Humanity.</jobString>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="ButcherAnneliEggs"]/description</xpath>
    <value>
      <description>Grind Annelitrice Ashes into five Souls.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="ButcherAnneliEggs"]/jobString</xpath>
    <value>
      <jobString>Grinding Annelitrice Ashes.</jobString>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CremateAnneliEggs"]/description</xpath>
    <value>
      <description>Destroy Annelitrice Ashes in a fire.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CremateAnneliEggs"]/jobString</xpath>
    <value>
      <jobString>Cremating Annelitrice Ashes.</jobString>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="Anneli_MakeNutrientSolution"]/label</xpath>
    <value>
      <label>extract annelitrice souls</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="Anneli_MakeNutrientSolution"]/description</xpath>
    <value>
      <description>Extract Souls from organic matter.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="Anneli_MakeNutrientSolution"]/jobString</xpath>
    <value>
      <jobString>Extracting Annelitrice Souls.</jobString>
    </value>
  </Operation>

</Patch>
