<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="AnnelitriceLarvaAsAnimal"]/label</xpath>
    <value>
      <label>annelitrice humanity</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="AnnelitriceLarvaAsAnimal"]/description</xpath>
    <value>
      <description>Annelitrice Undead are bound by a curse that denies them a proper death. When slain, their flesh collapses into Ashes, yet Humanity lingers within the remains. Their bodies are frail, easily broken but strangely difficult to destroy completely.\n\nThe curse does not remain with its bearer alone. An Annelitrice Undead may imprint the Darksign on another humanoid, causing Humanity to gather within the victim until Ashes carrying fragments of memory are shed. From these remnants emerge small, wandering phantoms of Humanity. Fed on Souls, these fragments of Humanity gradually take form and awaken once more in human shape.\n\nThey tend to gather in strange, insular groups. With much of their former lives lost to the curse, these communities are often built around half-remembered stories, faded identities, or whatever books, relics, and fragments of the past happen to remain in their possession.\n\nUse an Annelitrice Soul to kindle Ashes or restore a fallen Annelitrice Undead to life. A Bonfire can automate both rites.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_Fountain"]/label</xpath>
    <value>
      <label>annelitrice bonfire</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_Fountain"]/description</xpath>
    <value>
      <description>An anchor of Ashes and twisted iron where Annelitrice Undead can craft transmog apparel, items made from Ashes, and Annelitrice Souls.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_PuppetTheatre"]/label</xpath>
    <value>
      <label>annelitrice painted world</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_PuppetTheatre"]/description</xpath>
    <value>
      <description>A small Painted World of towers and snow-covered forests. Those within know they are watched by beings beyond the frame, yet fear has taught them silence. They live out their little lives beneath that gaze, pretending not to notice the eyes above.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_Anthelmintic"]/label</xpath>
    <value>
      <label>annelitrice blooming moss</label>
    </value>
  </Operation>

  <!-- ToDo -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_Anthelmintic"]/description</xpath>
    <value>
      <description>ToDo.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_ColonistEgg"]/label</xpath>
    <value>
      <label>annelitrice companion ashes</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_ColonistEgg"]/description</xpath>
    <value>
      <description>Ashes of the familiar.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_OutsiderEgg"]/label</xpath>
    <value>
      <label>annelitrice ashes</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_OutsiderEgg"]/description</xpath>
    <value>
      <description>Ashes of the forgotten.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_NutrientSolution"]/label</xpath>
    <value>
      <label>annelitrice soul</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_NutrientSolution"]/description</xpath>
    <value>
      <description>The lingering essence drawn from living things. To most, consuming a Soul is a deeply unnatural act, bringing nausea, fevered visions, and violent shocks to the mind. Annelitrice Undead can take Souls into themselves without harm, as living creatures digest food.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_Pupa"]/label</xpath>
    <value>
      <label>annelitrice human effigy</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_Pupa"]/description</xpath>
    <value>
      <description>A warm, shadow-like effigy in the shape of a person. It is not yet truly alive, but the form is nearly complete.</description>
    </value>
  </Operation>

  <!-- Keep every retheme image under its own texture root, including random variants and masks. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_Fountain"]/graphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_DarkSouls/Anneli_Building/Fountain</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_PuppetTheatre"]/graphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_DarkSouls/Anneli_Building/PuppetTheatre</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_Anthelmintic"]/graphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_DarkSouls/Anneli_Item/Anthelmintic</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_NutrientSolution"]/graphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_DarkSouls/Anneli_Item/NutrientSolution</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_ColonistEgg"]/graphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_DarkSouls/Anneli_Item/Egg_Colonist</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_OutsiderEgg"]/graphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_DarkSouls/Anneli_Item/Egg</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_Pupa"]/graphicData/texPath</xpath>
    <value>
      <texPath>Anneli_Retheme_DarkSouls/Anneli_Item/Pupa</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="AnnelitriceLarvaAsAnimal"]/statBases</xpath>
    <value>
      <MeatAmount>0</MeatAmount>
    </value>
  </Operation>
  
  <!-- Butchery yields Anneli_NutrientSolution -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="AnnelitriceLarvaAsAnimal"]</xpath>
    <value>
      <butcherProducts>
        <Anneli_NutrientSolution>10</Anneli_NutrientSolution>
      </butcherProducts>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Anneli_NutrientSolution"]/comps/li[@Class="CompProperties_Usable"]/useLabel</xpath>
    <value>
      <useLabel>use annelitrice soul</useLabel>
    </value>
  </Operation>

</Patch>
